<Window x:Class="SnmpSimulator.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SNMP Simulator v0.1.0" Width="720" Height="450" MinWidth="650" MinHeight="420">
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="SNMP Simulator" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="單一設備 · SNMP v1 / v2c · 唯讀" Margin="0,6,0,20"/></StackPanel>
  <DockPanel Grid.Row="1" Margin="0,0,0,16"><Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="選擇 JSON…" Click="Browse_Click" Padding="12,6" Margin="12,0,0,0"/><TextBox x:Name="ProfilePath" VerticalContentAlignment="Center" AutomationProperties.Name="設備設定檔路徑"/></DockPanel>
  <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,20"><TextBlock Text="本機 IPv4" VerticalAlignment="Center"/><TextBox x:Name="BindAddress" Text="127.0.0.1" Width="150" Margin="12,0,24,0" Padding="6"/><TextBlock Text="UDP Port" VerticalAlignment="Center"/><TextBox x:Name="Port" Text="161" Width="80" Margin="12,0,0,0" Padding="6"/></StackPanel>
  <StackPanel Grid.Row="3" Orientation="Horizontal"><Button x:Name="StartButton" Content="開始模擬" Click="Start_Click" Padding="24,8"/><Button Content="授權聲明" Click="Licenses_Click" Padding="16,8" Margin="12,0,0,0"/><Button x:Name="StopButton" Content="停止" Click="Stop_Click" IsEnabled="False" Padding="24,8" Margin="12,0,0,0"/></StackPanel>
  <StackPanel Grid.Row="4" Margin="0,24,0,0"><TextBlock x:Name="Status" Text="請選擇設定檔後開始模擬。" TextWrapping="Wrap"/><TextBlock x:Name="Counters" Margin="0,16,0,0" TextWrapping="Wrap"/><TextBlock Text="修改設定檔後，請停止並重新開始。" Margin="0,20,0,0" Foreground="DimGray"/></StackPanel>
 </Grid>
</Window>
